{
  "version": 11,
  "configurePresets": [
    {
      "name": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "hidden": true,
      "environment": {
        "WARNINGFLAGS": "-Wall -Wextra -pedantic -Wno-reserved-module-identifier -Wno-deprecated-declarations -Qunused-arguments",
        "CXXFLAGSBASE" : "$penv{CXXFLAGS} -stdlib=libc++ -fuse-ld=lld $env{WARNINGFLAGS}",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "TRUE"
      }, 
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "environment": {
        "CXXFLAGS": "$env{CXXFLAGSBASE} -g",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/ubsan.cmake"
      }
    },
    {
      "name": "fastdebug",
      "inherits": "debug",
      "environment": {
        "CXXFLAGS":"$env{CXXFLAGSBASE} -g -O3 -flto"
      }
    },
    {
      "name": "nodebug",
      "inherits": "base",
      "environment": {
        "CXXFLAGS": "$env{CXXFLAGSBASE} -O3 -DNDEBUG -flto -Wl,--icf=safe"
      }    
    },
    {
      "name": "smallnodebug",
      "inherits": "base",
      "environment": {
        "CXXFLAGS": "$env{CXXFLAGSBASE} -Oz -DNDEBUG -flto -Wl,--icf=safe"
      }    
    }
  ]
}
